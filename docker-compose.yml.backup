version: "3.9"

services:
  db:
    image: postgres:16-alpine
    container_name: socbalena_db
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-socbalena}
      POSTGRES_USER: ${POSTGRES_USER:-socbalena}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-socbalena_secret}
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./db/init.sql:/docker-entrypoint-initdb.d/init.sql
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-socbalena}"]
      interval: 10s
      timeout: 5s
      retries: 5

  backend:
    build: ./backend
    container_name: socbalena_backend
    restart: unless-stopped
    environment:
      DATABASE_URL: postgres://${POSTGRES_USER:-socbalena}:${POSTGRES_PASSWORD:-socbalena_secret}@db:5432/${POSTGRES_DB:-socbalena}
      JWT_SECRET: ${JWT_SECRET:-canvia_aquest_secret_en_produccio}
      NODE_ENV: ${NODE_ENV:-development}
      UPLOAD_DIR: /app/uploads
    volumes:
      - uploads:/app/uploads
    depends_on:
      db:
        condition: service_healthy
    ports:
      - "3002:3000"

  frontend:
    build: ./nginx
    container_name: socbalena_frontend
    restart: unless-stopped
    volumes:
      - ./frontend:/usr/share/nginx/html:ro
      - uploads:/usr/share/nginx/uploads:ro
    ports:
      - "8085:80"
    depends_on:
      - backend

volumes:
  pgdata:
  uploads:
